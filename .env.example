# --- Application ---------------------------------------------------------
APP_NAME=Riff API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ------------------------------------------------------------
# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...).
DATABASE_URL=sqlite:///./riff.db
AUTO_CREATE_TABLES=true

# --- Providers -----------------------------------------------------------
# auto  -> Groq when GROQ_API_KEY is set, offline demo provider otherwise
# groq  -> always Groq (falls back to demo with a warning if the key is missing)
# stub  -> always the offline demo provider
VISION_PROVIDER=auto
GENERATION_PROVIDER=auto
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-vl-27b
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile

# --- Pipeline ------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
VISION_MAX_DIMENSION=1568
VISION_JPEG_QUALITY=85
DRAFT_COUNT=3
VOICE_SAMPLE_LIMIT=3
SIMILARITY_THRESHOLD=0.85
NGRAM_OVERLAP_THRESHOLD=0.40
